<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/surface"
    android:orientation="vertical"
    android:paddingStart="8dp"
    android:paddingTop="12dp"
    android:paddingEnd="8dp"
    android:paddingBottom="10dp">

    <TextView
        android:id="@+id/tvImeStatus"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/status_background"
        android:padding="14dp"
        android:text="@string/status_ime_idle"
        android:textColor="@color/text_primary"
        android:textSize="15sp" />

    <Button
        android:id="@+id/btnImeMode"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:text="@string/ime_action_edit"
        android:textAllCaps="false" />

    <Button
        android:id="@+id/btnImeToggle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:minHeight="52dp"
        android:text="@string/ime_action_hold"
        android:textAllCaps="false" />

    <LinearLayout
        android:id="@+id/layoutEditActions"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:orientation="vertical"
        android:visibility="gone">

        <TextView
            android:id="@+id/tvPinyinBuffer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/ime_buffer_background"
            android:minHeight="38dp"
            android:paddingStart="12dp"
            android:paddingTop="7dp"
            android:paddingEnd="12dp"
            android:paddingBottom="7dp"
            android:text=""
            android:textColor="@color/text_secondary"
            android:textSize="14sp" />

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="42dp"
            android:layout_marginTop="6dp"
            android:background="@drawable/ime_candidate_background"
            android:paddingStart="8dp"
            android:paddingTop="4dp"
            android:paddingEnd="8dp"
            android:paddingBottom="4dp">

            <HorizontalScrollView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="center_vertical"
                android:scrollbars="none">

                <LinearLayout
                    android:id="@+id/layoutCandidateBar"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal" />
            </HorizontalScrollView>
        </FrameLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:orientation="horizontal">

            <Button android:id="@+id/keyQ" android:layout_width="0dp" android:layout_height="46dp" android:layout_weight="1" android:minWidth="0dp" android:paddingStart="0dp" android:paddingEnd="0dp" android:text="Q" android:textAllCaps="false" android:textSize="17sp" />
            <Space android:layout_width="3dp" android:layout_height="1dp" />
            <Button android:id="@+id/keyW" android:layout_width="0dp" android:layout_height="46dp" android:layout_weight="1" android:minWidth="0dp" android:paddingStart="0dp" android:paddingEnd="0dp" android:text="W" android:textAllCaps="false" android:textSize="17sp" />
            <Space android:layout_width="3dp" android:layout_height="1dp" />
            <Button android:id="@+id/keyE" android:layout_width="0dp" android:layout_height="46dp" android:layout_weight="1" android:minWidth="0dp" android:paddingStart="0dp" android:paddingEnd="0dp" android:text="E" android:textAllCaps="false" android:textSize="17sp" />
            <Space android:layout_width="3dp" android:layout_height="1dp" />
            <Button android:id="@+id/keyR" android:layout_width="0dp" android:layout_height="46dp" android:layout_weight="1" android:minWidth="0dp" android:paddingStart="0dp" android:paddingEnd="0dp" android:text="R" android:textAllCaps="false" android:textSize="17sp" />
            <Space android:layout_width="3dp" android:layout_height="1dp" />
            <Button android:id="@+id/keyT" android:layout_width="0dp" android:layout_height="46dp" android:layout_weight="1" android:minWidth="0dp" android:paddingStart="0dp" android:paddingEnd="0dp" android:text="T" android:textAllCaps="false" android:textSize="17sp" />
            <Space android:layout_width="3dp" android:layout_height="1dp" />
            <Button android:id="@+id/keyY" android:layout_width="0dp" android:layout_height="46dp" android:layout_weight="1" android:minWidth="0dp" android:paddingStart="0dp" android:paddingEnd="0dp" android:text="Y" android:textAllCaps="false" android:textSize="17sp" />
            <Space android:layout_width="3dp" android:layout_height="1dp" />
            <Button android:id="@+id/keyU" android:layout_width="0dp" android:layout_height="46dp" android:layout_weight="1" android:minWidth="0dp" android:paddingStart="0dp" android:paddingEnd="0dp" android:text="U" android:textAllCaps="false" android:textSize="17sp" />
            <Space android:layout_width="3dp" android:layout_height="1dp" />
            <Button android:id="@+id/keyI" android:layout_width="0dp" android:layout_height="46dp" android:layout_weight="1" android:minWidth="0dp" android:paddingStart="0dp" android:paddingEnd="0dp" android:text="I" android:textAllCaps="false" android:textSize="17sp" />
            <Space android:layout_width="3dp" android:layout_height="1dp" />
            <Button android:id="@+id/keyO" android:layout_width="0dp" android:layout_height="46dp" android:layout_weight="1" android:minWidth="0dp" android:paddingStart="0dp" android:paddingEnd="0dp" android:text="O" android:textAllCaps="false" android:textSize="17sp" />
            <Space android:layout_width="3dp" android:layout_height="1dp" />
            <Button android:id="@+id/keyP" android:layout_width="0dp" android:layout_height="46dp" android:layout_weight="1" android:minWidth="0dp" android:paddingStart="0dp" android:paddingEnd="0dp" android:text="P" android:textAllCaps="false" android:textSize="17sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:orientation="horizontal"
            android:paddingStart="10dp"
            android:paddingEnd="10dp">

            <Button android:id="@+id/keyA" android:layout_width="0dp" android:layout_height="46dp" android:layout_weight="1" android:minWidth="0dp" android:paddingStart="0dp" android:paddingEnd="0dp" android:text="A" android:textAllCaps="false" android:textSize="17sp" />
            <Space android:layout_width="3dp" android:layout_height="1dp" />
            <Button android:id="@+id/keyS" android:layout_width="0dp" android:layout_height="46dp" android:layout_weight="1" android:minWidth="0dp" android:paddingStart="0dp" android:paddingEnd="0dp" android:text="S" android:textAllCaps="false" android:textSize="17sp" />
            <Space android:layout_width="3dp" android:layout_height="1dp" />
            <Button android:id="@+id/keyD" android:layout_width="0dp" android:layout_height="46dp" android:layout_weight="1" android:minWidth="0dp" android:paddingStart="0dp" android:paddingEnd="0dp" android:text="D" android:textAllCaps="false" android:textSize="17sp" />
            <Space android:layout_width="3dp" android:layout_height="1dp" />
            <Button android:id="@+id/keyF" android:layout_width="0dp" android:layout_height="46dp" android:layout_weight="1" android:minWidth="0dp" android:paddingStart="0dp" android:paddingEnd="0dp" android:text="F" android:textAllCaps="false" android:textSize="17sp" />
            <Space android:layout_width="3dp" android:layout_height="1dp" />
            <Button android:id="@+id/keyG" android:layout_width="0dp" android:layout_height="46dp" android:layout_weight="1" android:minWidth="0dp" android:paddingStart="0dp" android:paddingEnd="0dp" android:text="G" android:textAllCaps="false" android:textSize="17sp" />
            <Space android:layout_width="3dp" android:layout_height="1dp" />
            <Button android:id="@+id/keyH" android:layout_width="0dp" android:layout_height="46dp" android:layout_weight="1" android:minWidth="0dp" android:paddingStart="0dp" android:paddingEnd="0dp" android:text="H" android:textAllCaps="false" android:textSize="17sp" />
            <Space android:layout_width="3dp" android:layout_height="1dp" />
            <Button android:id="@+id/keyJ" android:layout_width="0dp" android:layout_height="46dp" android:layout_weight="1" android:minWidth="0dp" android:paddingStart="0dp" android:paddingEnd="0dp" android:text="J" android:textAllCaps="false" android:textSize="17sp" />
            <Space android:layout_width="3dp" android:layout_height="1dp" />
            <Button android:id="@+id/keyK" android:layout_width="0dp" android:layout_height="46dp" android:layout_weight="1" android:minWidth="0dp" android:paddingStart="0dp" android:paddingEnd="0dp" android:text="K" android:textAllCaps="false" android:textSize="17sp" />
            <Space android:layout_width="3dp" android:layout_height="1dp" />
            <Button android:id="@+id/keyL" android:layout_width="0dp" android:layout_height="46dp" android:layout_weight="1" android:minWidth="0dp" android:paddingStart="0dp" android:paddingEnd="0dp" android:text="L" android:textAllCaps="false" android:textSize="17sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btnShift"
                android:layout_width="0dp"
                android:layout_height="46dp"
                android:layout_weight="1.28"
                android:minWidth="0dp"
                android:paddingStart="0dp"
                android:paddingEnd="0dp"
                android:text="↑"
                android:textAllCaps="false"
                android:textSize="18sp" />

            <Space android:layout_width="3dp" android:layout_height="1dp" />

            <Button android:id="@+id/keyZ" android:layout_width="0dp" android:layout_height="46dp" android:layout_weight="1" android:minWidth="0dp" android:paddingStart="0dp" android:paddingEnd="0dp" android:text="Z" android:textAllCaps="false" android:textSize="17sp" />
            <Space android:layout_width="3dp" android:layout_height="1dp" />
            <Button android:id="@+id/keyX" android:layout_width="0dp" android:layout_height="46dp" android:layout_weight="1" android:minWidth="0dp" android:paddingStart="0dp" android:paddingEnd="0dp" android:text="X" android:textAllCaps="false" android:textSize="17sp" />
            <Space android:layout_width="3dp" android:layout_height="1dp" />
            <Button android:id="@+id/keyC" android:layout_width="0dp" android:layout_height="46dp" android:layout_weight="1" android:minWidth="0dp" android:paddingStart="0dp" android:paddingEnd="0dp" android:text="C" android:textAllCaps="false" android:textSize="17sp" />
            <Space android:layout_width="3dp" android:layout_height="1dp" />
            <Button android:id="@+id/keyV" android:layout_width="0dp" android:layout_height="46dp" android:layout_weight="1" android:minWidth="0dp" android:paddingStart="0dp" android:paddingEnd="0dp" android:text="V" android:textAllCaps="false" android:textSize="17sp" />
            <Space android:layout_width="3dp" android:layout_height="1dp" />
            <Button android:id="@+id/keyB" android:layout_width="0dp" android:layout_height="46dp" android:layout_weight="1" android:minWidth="0dp" android:paddingStart="0dp" android:paddingEnd="0dp" android:text="B" android:textAllCaps="false" android:textSize="17sp" />
            <Space android:layout_width="3dp" android:layout_height="1dp" />
            <Button android:id="@+id/keyN" android:layout_width="0dp" android:layout_height="46dp" android:layout_weight="1" android:minWidth="0dp" android:paddingStart="0dp" android:paddingEnd="0dp" android:text="N" android:textAllCaps="false" android:textSize="17sp" />
            <Space android:layout_width="3dp" android:layout_height="1dp" />
            <Button android:id="@+id/keyM" android:layout_width="0dp" android:layout_height="46dp" android:layout_weight="1" android:minWidth="0dp" android:paddingStart="0dp" android:paddingEnd="0dp" android:text="M" android:textAllCaps="false" android:textSize="17sp" />

            <Space android:layout_width="3dp" android:layout_height="1dp" />

            <Button
                android:id="@+id/keyBackspace"
                android:layout_width="0dp"
                android:layout_height="46dp"
                android:layout_weight="1.28"
                android:minWidth="0dp"
                android:paddingStart="0dp"
                android:paddingEnd="0dp"
                android:text="⌫"
                android:textAllCaps="false"
                android:textSize="18sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btnQuickSymbol"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1.02"
                android:minWidth="0dp"
                android:paddingStart="0dp"
                android:paddingEnd="0dp"
                android:text="符"
                android:textAllCaps="false"
                android:textSize="15sp" />

            <Space android:layout_width="3dp" android:layout_height="1dp" />

            <Button
                android:id="@+id/btnMode123"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1.02"
                android:minWidth="0dp"
                android:paddingStart="0dp"
                android:paddingEnd="0dp"
                android:text="123"
                android:textAllCaps="false"
                android:textSize="15sp" />

            <Space android:layout_width="3dp" android:layout_height="1dp" />

            <Button
                android:id="@+id/keySpace"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="2.52"
                android:minWidth="0dp"
                android:paddingStart="0dp"
                android:paddingEnd="0dp"
                android:text="@string/ime_action_space"
                android:textAllCaps="false"
                android:textSize="15sp" />

            <Space android:layout_width="3dp" android:layout_height="1dp" />

            <Button
                android:id="@+id/btnLangToggle"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="0.92"
                android:minWidth="0dp"
                android:paddingStart="0dp"
                android:paddingEnd="0dp"
                android:text="中"
                android:textAllCaps="false"
                android:textSize="16sp" />

            <Space android:layout_width="3dp" android:layout_height="1dp" />

            <Button
                android:id="@+id/keyEnter"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1.18"
                android:minWidth="0dp"
                android:paddingStart="0dp"
                android:paddingEnd="0dp"
                android:text="@string/ime_action_enter"
                android:textAllCaps="false"
                android:textSize="15sp" />
        </LinearLayout>
    </LinearLayout>

</LinearLayout>
